<service><id>ContactCenterHub</id><name>Contact Center Hub API</name><description>Backend empresarial en loopback</description><executable>C:\Program Files\nodejs\node.exe</executable><arguments>--env-file=C:\ProgramData\ContactCenterHub\runtime.env C:\Services\ContactCenterHub\dist\api\main.js</arguments><workingdirectory>C:\Services\ContactCenterHub</workingdirectory><log mode="roll"/><onfailure action="restart" delay="10 sec"/></service>
