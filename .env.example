NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:4200
SQL_SERVER=localhost
SQL_PORT=14331
SQL_DATABASE=ContactCenterHub_Dev
SQL_AUTH=windows
SQL_USER=
SQL_PASSWORD=
LOCAL_AUTH_ENABLED=false

# Generada por admin:local, nunca publicar ni reemplazar sin recifrar los secretos MFA.
MFA_ENCRYPTION_KEY=

# true omite la validación del certificado SQL; el cifrado permanece activo.
SQL_TRUST_SERVER_CERTIFICATE=false

# Microsoft Entra ID - pruebas locales (plataforma Web).
# Completar los tres valores juntos y reiniciar la API.
# OIDC_ISSUER: https://login.microsoftonline.com/PEGAR_TENANT_ID/v2.0
# OIDC_CLIENT_ID: pegar Application (client) ID.
# OIDC_CLIENT_SECRET: pegar el VALOR del secreto entre comillas, no su ID.
# Mientras OIDC_ISSUER esté vacío, el acceso corporativo sigue deshabilitado.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=""
OIDC_REDIRECT_URI=http://localhost:4200/api/auth/callback

# Instalador de paquetes firmados. Ejecutar módulos con Node >=26, sin permisos de red.
MODULE_NODE="C:/Program Files/nodejs/node.exe"
MODULE_TRUST_FILE=.local/module-publishers.json
