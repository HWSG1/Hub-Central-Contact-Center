{
  "name": "contact-center-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p apps/portal-api/tsconfig.json && node scripts/finish-build.cjs",
    "build:web": "ng build",
    "start:api": "node --env-file=.env dist/api/main.js",
    "start:web": "node --env-file=.env scripts/start-web.cjs",
    "test": "tsx --test tests/security/*.test.ts && npm run docs:check",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "admin:provision": "tsx --env-file=.env scripts/provision.ts",
    "admin:local": "tsx --env-file=.env scripts/admin-local.ts",
    "admin:remote": "tsx scripts/admin-remote.ts",
    "db:check": "tsx --env-file=.env scripts/check-connection.ts",
    "docs:build": "node scripts/build-install-sql.cjs",
    "docs:check": "node scripts/build-install-sql.cjs --check",
    "modules:publisher": "tsx scripts/module-publisher.ts",
    "modules:package:offers": "tsx scripts/package-independent-offers.ts",
    "modules:pack": "tsx scripts/package-module.ts"
  },
  "dependencies": {
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/router": "22.2.6",
    "@fontsource/inter": "^5.2.8",
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "fflate": "^0.8.3",
    "helmet": "^8.1.0",
    "msnodesqlv8": "^5.1.1",
    "mssql": "^12.1.0",
    "openid-client": "^6.8.1",
    "otpauth": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.5",
    "@types/mssql": "^9.1.8",
    "@types/node": "^24.10.0",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "esbuild": "0.28.2"
  }
}
